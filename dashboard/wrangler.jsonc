{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mimotion-dashboard",
  "main": "dist/worker.js",
  "account_id": "94304fd699fbc51c59d2124f311b2862",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ORIGIN": "https://s.dqai.cc",
    "MAX_ACCOUNTS": "200",
    "LEGACY_ORIGIN": "https://mimotion-dashboard.113618446.workers.dev"
  },
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mimotion-users",
      "database_id": "69777f7e-0e50-4473-b28c-99dd024f9756",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "mimotion-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "mimotion-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 3,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "routes": [
    {
      "pattern": "s.dqai.cc",
      "custom_domain": true
    }
  ]
}
