{
  "name": "mimotion-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js --loader:.html=text --loader:.css=text",
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretest": "npm run build"
  },
  "dependencies": {
    "tweetnacl-sealedbox-js": "1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "esbuild": "^0.25.0",
    "miniflare": "5.20260911.1-alpha",
    "wrangler": "4.131.2"
  }
}
